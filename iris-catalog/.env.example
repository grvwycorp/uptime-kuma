# Uptime Kuma master connection (Socket.IO)
KUMA_URL=http://localhost:3001
KUMA_USERNAME=admin
KUMA_PASSWORD=

# OTEL Collector Prometheus endpoint (probe metrics)
OTEL_PROM_URL=http://localhost:8889/metrics

# Catalog auth (internal access)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Status polling interval in ms (default 8s)
STATUS_POLL_INTERVAL=8000
