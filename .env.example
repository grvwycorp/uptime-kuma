# Uptime Kuma credentials for OTEL collector to scrape /metrics
# Must match the admin user you create in Uptime Kuma
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=your-password-here

# Grafana Cloud OTLP settings
# Get these from Grafana Cloud > Connections > Add new connection > OpenTelemetry
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
GRAFANA_INSTANCE_ID=29592
GRAFANA_API_KEY=glc_eyJvIjoiMTE4MjMzIi...

# Environment label for metrics
DEPLOYMENT_ENV=production
